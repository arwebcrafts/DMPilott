# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Meta / Facebook App
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Instagram App secret — used for the new Instagram Business Login flow
# Usually the same value as META_APP_SECRET (same Meta App)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Local dev only — set USE_DEV_INSTAGRAM_TOKENS=true to test DM sending with a single account token
USE_DEV_INSTAGRAM_TOKENS=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Vercel Cron secret — set any random string, Vercel sends it in Authorization header.
# REQUIRED in production: the cron routes send DMs and rotate tokens, so they
# return 503 rather than run unauthenticated when this is missing.
CRON_SECRET=

# Local dev only. Skips Meta webhook signature verification so you can replay
# payloads by hand. Ignored in production — never rely on it there.
SKIP_WEBHOOK_SIGNATURE=

# Token encryption (AES-256 — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# QStash by Upstash (replaces BullMQ for Vercel-compatible job queuing)
# Get these from https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Redis (BullMQ — only needed for local development)
REDIS_URL=

# OpenAI (AI replies planned; not wired yet. Server-side only.)
OPENAI_API_KEY=
